test::cd_test_dir()
{
   log_entry "test::cd_test_dir" "$@"

   # shellcheck source=src/mulle-test-locate.sh
   . "${MULLE_TEST_LIBEXEC_DIR}/mulle-test-locate.sh"

   MULLE_TEST_DIR="${MULLE_TEST_DIR:-test}"
   test::locate::r_test_dir "${MULLE_TEST_DIR}"
   rc=$?

   if [ $rc -eq 1 ]
   then
      fail "Did not find a \"${MULLE_TEST_DIR}\" directory (${MULLE_USER_PWD})
${C_INFO}Initialize tests with:
${C_RESET_BOLD}   mulle-sde test init"
   fi

   r_absolutepath "${RVAL}"
   MULLE_TEST_DIR="${RVAL}"
   if [ -d "${MULLE_TEST_DIR}/.mulle/share/sde" -a \
       ! -d "${MULLE_TEST_DIR}/.mulle/share/test" ]
   then
      fail "\"${MULLE_TEST_DIR}\" is not a mulle-sde project marked for mulle-test"
   fi

   if [ "${PWD}" != "${MULLE_TEST_DIR}" ]
   then
      log_fluff "Going to test directory \"${MULLE_TEST_DIR}\" (${PWD#"${MULLE_USER_PWD}/"})"
      exekutor cd "${MULLE_TEST_DIR}" || exit 1
   fi

   return $rc
}



test::r_escape_args()
{
  local arg

  RVAL=""
  for arg in "$@"
  do
     r_concat "${RVAL}" $(printf '%q' "${arg}")
  done
}



test::do_run()
{
   log_entry "test::do_run" "$@"

   local cmd
   local OPTION_RUN_SCRIPT='YES'

   log_verbose "Run tests"

   # Check for --help before doing anything that requires a project environment
   local arg
   for arg in "$@"
   do
      case "${arg}" in
         -h|--help|help)
            include "test::run"
            test::run::usage
         ;;

         --no-run-script)
            OPTION_RUN_SCRIPT='NO'
         ;;

         --)
            break
         ;;
      esac
   done

   # legacy support :)
   if [ "${OPTION_RUN_SCRIPT}" = 'YES' -a -x "./run-test" ]
   then
      cmd="./run-test ${MULLE_TECHNICAL_FLAGS}"
   else
      # shellcheck source=src/mulle-test-run.sh
      include "test::run"

      cmd="test::run::main"
   fi

   eval `mulle-sde tool-env` || exit 1

   [ -z "${DEPENDENCY_DIR}" ] && _internal_fail "DEPENDENCY_DIR not set"

   local environment

   if [ -z "${MULLE_TEST_EXECUTABLE}" ]
   then
      include "test::compiler"

      if test::compiler::r_env_sanitizer_flags "${SANITIZER}"
      then
         environment="${RVAL}"
      fi
   fi

   test::r_escape_args "$@"

   set -- ${environment} ${cmd} "${RVAL}"
   # Need this to be eval for the environment

   eval_exekutor "$@"
}



test::run_or_rerun()
{
   log_entry "test::run_or_rerun" "$@"

   local cmd="$1"; shift

   if [ "${cmd}" = "rerun" ]
   then
      test::do_run --rerun "$@"
   else
      test::do_run "$@"
   fi
}



test::_main()
{
   local FLAG_OUTSIDE_ENV="NO"       # need comment
   local MULLE_FLAG_DEFER="DEFAULT"
   local MULLE_TEST_DEFINE='YES'
   local OPTION_CLEAN='DEFAULT'
   local OPTION_CRAFT='DEFAULT'
   local OPTION_CONFIGURATION
   local SANITIZER

   #
   # On MacOS with the default Foundation/objc we can't
   # use the testallocator, because the singletons won't
   # get reclaimed
   #
   case "${MULLE_TEST_OBJC_DIALECT:-mulle-objc}" in
      mulle-objc)
         case "${MULLE_UNAME}" in
            darwin)
               SANITIZER="gmalloc:testallocator"
            ;;

            linux)
               SANITIZER="glibc:testallocator"
            ;;

            # mulle_atinit does not work on wimdows so we
            # can't reliably inject the testallocator
            'mingw'|'msys'|'windows')
               SANITIZER=""
            ;;

            *)
               SANITIZER="testallocator"
            ;;
         esac
      ;;

      *)
         case "${MULLE_UNAME}" in
            darwin)
               SANITIZER="gmalloc"
            ;;

            darwin)
               SANITIZER="glibc"
            ;;
         esac
      ;;
   esac


   #
   # simple option handling:
   # MEMO: flags that you define here must be mirrored in
   #       test::run::_run_in_directory!!!
   #
   while [ $# -ne 0 ]
   do
      if options_technical_flags "$1"
      then
         shift
         continue
      fi

      case "$1" in
         -h|--help|help)
            test::usage "${MULLE_TRACE}"
         ;;

         -f|--force)
            MULLE_FLAG_MAGNUM_FORCE="BOTH"
         ;;

         --platform)
            [ $# -eq 1 ] && fail "Missing argument to \"$1\""
            shift

            TEST_PLATFORM="$1"
         ;;

         --configuration)
            [ $# -eq 1 ] && fail "Missing argument to \"$1\""
            shift

            OPTION_CONFIGURATION="$1"
         ;;

         --debug)
            OPTION_CONFIGURATION="Debug"
         ;;

         --release)
            OPTION_CONFIGURATION="Release"
         ;;

         -d|--dir-name)
            [ $# -eq 1 ] && fail "Missing argument to \"$1\""
            shift

            MULLE_TEST_DIR="$1"
         ;;

         --dependency-dir)
            [ $# -eq 1 ] && fail "Missing argument to \"$1\""
            shift

            DEPENDENCY_DIR="$1"
         ;;

         ##

         --valgrind)
            # no others beside  "valgrind"
            SANITIZER="valgrind"
         ;;

         --valgrind-no-leaks)
            # no others beside  "valgrind-no-leaks"
            SANITIZER="valgrind-no-leaks"
         ;;

         --coverage)
            r_colon_concat "${SANITIZER}" "coverage"
            SANITIZER="${RVAL}"
         ;;

         --objc-coverage)
            r_colon_concat "${SANITIZER}" "objc-coverage"
            SANITIZER="${RVAL}"
         ;;

         --gdb)
            r_colon_concat "${SANITIZER}" "gdb"
            SANITIZER="${RVAL}"
         ;;

         --sanitize-address)
            # no others beside  "address"
            SANITIZER="address"
         ;;

         --sanitize-undefined)
            # no others beside  "undefined"
            SANITIZER="undefined"
         ;;

         --sanitize-thread)
            # no others beside  "thread"
            SANITIZER="thread"
         ;;

         --testallocator)
            r_colon_remove "${SANITIZER}" "testallocator"
            r_colon_remove "${RVAL}" "zombie"
            r_colon_concat "${RVAL}" "testallocator"
            SANITIZER="${RVAL}"
         ;;

         --zombie)
            r_colon_remove "${SANITIZER}" "testallocator"
            r_colon_remove "${RVAL}" "zombie"
            r_colon_concat "${RVAL}" "zombie"
            SANITIZER="${RVAL}"
         ;;

         --add-sanitizer|--add-memory-checker)
            [ $# -eq 1 ] && fail "Missing argument to \"$1\""
            shift

            r_colon_concat "${SANITIZER}" "$1"
            SANITIZER="${RVAL}"
         ;;

         --no-sanitizer|--no-sanitizers|--no-memory-checker|--no-memory-checkers)
            SANITIZER=
         ;;

         # for benefit of test runner, not API
         --sanitizer)
            [ $# -eq 1 ] && fail "Missing argument to \"$1\""
            shift

            SANITIZER="$1"
         ;;

         #
         #
         #
         --no-mulle-test-define)
            MULLE_TEST_DEFINE='NO'
         ;;

         --version)
            printf "%s\n" "${MULLE_EXECUTABLE_VERSION}"
            exit 0
         ;;

         --)
            shift
            break
         ;;

         -*)
            fail "Unknown option \"$1\""
         ;;

         *)
            break
         ;;
      esac

      shift
   done

   options_setup_trace "${MULLE_TRACE}" && set -x

   TEST_PLATFORM="${TEST_PLATFORM:-${MULLE_TEST_PLATFORMS%%:*}}"
   TEST_PLATFORM="${TEST_PLATFORM:-${MULLE_UNAME}}"
   TEST_CONFIGURATION="${OPTION_CONFIGURATION:-Debug}"
   TEST_SDK="${OPTION_SDK:-Default}"

   [ -z "${TEST_PLATFORM}" ] && fail "TEST_PLATFORM is empty"
   [ -z "${TEST_CONFIGURATION}" ] && fail "TEST_CONFIGURATION is empty"
   [ -z "${TEST_SDK}" ] && fail "TEST_SDK is empty"

   export TEST_PLATFORM TEST_CONFIGURATION TEST_SDK

   local cmd="$1"

   case "$cmd" in
      'arch')
         printf "%s\n" "${MULLE_ARCH}"
         exit 0
      ;;

      'version')
         printf "%s\n" "${MULLE_EXECUTABLE_VERSION}"
         exit 0
      ;;

      'uname')
         printf "%s\n" "${MULLE_UNAME}"
         exit 0
      ;;

      'libexec-dir')
         printf "%s\n" "${MULLE_TEST_LIBEXEC_DIR}"
         exit 0
      ;;

      'platform')
         printf "%s\n" "${TEST_PLATFORM}"
         exit 0
      ;;

      'sanitizers')
         printf "%s\n" "address" "thread" "undefined" "valgrind" "valgrind-no-leaks" "testallocator" "zombie" "gmalloc" "glibc"
         exit 0
      ;;


      '')
         cmd=run
         [ $# -ne 0 ] && shift
      ;;

      -*)
         cmd=run
      ;;

      *)
         case "${cmd}" in
            build|clean|coverage|env|init|libexec-dir|linkorder|log\
|rerun|run|test-dir|version)
               shift
            ;;

            /*|.*)
               cmd='run'
            ;;

            *)
               if [ -e "${MULLE_USER_PWD}/${cmd}" ]
               then
                  cmd='run'
               else
                  shift
               fi
            ;;
         esac
      ;;
   esac

#   log_setting "MULLE_VIBECODING='${MULLE_VIBECODING}'"
#
#   # escalate to -vv for AI to figure out what stderr and stdout does
#   if [ "${MULLE_VIBECODING}" = 'YES' ]
#   then
#      MULLE_TECHNICAL_FLAGS="-vv ${MULLE_TECHNICAL_FLAGS}"
#      log_vibe "Set verbosity to at least -vv because MULLE_VIBECODING is YES"
#   fi



   MULLE_TEST_DIR="${MULLE_TEST_DIR:-${PWD}}"
   MULLE_TEST_VAR_DIR="${MULLE_TEST_DIR}/.mulle/var/${MULLE_HOSTNAME}/${MULLE_USERNAME}/test"

   log_setting "TEST_PLATFORM=${TEST_PLATFORM}"
   log_setting "MULLE_UNAME=${MULLE_UNAME}"

   log_setting "MULLE_TEST_VAR_DIR=${MULLE_TEST_VAR_DIR}"
   log_setting "MULLE_USER_PWD=${MULLE_USER_PWD}"
   log_setting "MULLE_VIRTUAL_ROOT=${MULLE_VIRTUAL_ROOT}"
   log_setting "SANITIZER=${SANITIZER}"

   #
   # .mulle/share/sde/mulle-sde is present, to prevent manual crafting
   # of tests, which is undesirable
   #
   MULLE_TEST_ENVIRONMENT=YES
   export MULLE_TEST_ENVIRONMENT

   case "${cmd}" in
      clean)
         include "test::clean"

         test::clean::main "$@"
      ;;

      run|rerun)
         # Just run tests - crafting is now handled by mulle-sde test
         test::run_or_rerun "${cmd}" "$@"
      ;;

      coverage)
        # if test::cd_test_dir
        # then
        #    test::exec_in_subshell_if_needed "${cmd}" "$@"
        # fi

         include "test::coverage"

         test::coverage::main "$@"
      ;;


      env)
         rexekutor env | sort
      ;;


      init)
         include "test::init"

         test::init::main "$@"
      ;;


      libexec-dir)
         printf "%s\n" "${MULLE_TEST_LIBEXEC_DIR}"
         exit 0
      ;;

      link-args)
         # if test::cd_test_dir
         # then
         #    test::exec_in_subshell_if_needed "${cmd}" "$@"
         # fi
#
         include "test::link-args"

         test::link_args::main "$@"
      ;;

      test-dir)
         # shellcheck source=src/mulle-test-locate.sh
         include "test::locate"

         test::locate::r_main "$@"
         printf "%s\n" "${RVAL}"
      ;;

      version)
         printf "%s\n" "${MULLE_EXECUTABLE_VERSION}"
         exit 0
      ;;

      *)
         log_error "Unknown command \"${cmd}\""
         test::usage "${MULLE_TRACE}"
      ;;
   esac
}


test::main()
{
   # Platform loop is now handled by mulle-sde test
   # Just run the tests directly
   test::_main "$@"
}


if [ -z "${MULLE_ARCH}" ]
then
   MULLE_ARCH="`gcc -v 2>&1  | sed -n -e '/Target:/s/.*: \([^-]*\)-.*/\1/p'`"
   MULLE_ARCH="${MULLE_ARCH:-`arch 2> /dev/null`}"
   MULLE_ARCH="${MULLE_ARCH:-x86_64}"
   export MULLE_ARCH
fi

call_with_flags "test::main" "${MULLE_TEST_FLAGS}" "$@"
