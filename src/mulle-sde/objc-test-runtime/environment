#
# For more aggressive leak testing, it is good if singletons cleanup
# in the NSAutoreleasePool. These ephemerals aren't thread safe singletons.
#
MULLE_OBJC_EPHEMERAL_SINGLETON="YES"

#
# For new projects its better to keep this on "ignore" first, and then change
# it to "warn" or "error" later
#
MULLE_TEST_WHITESPACE_DIFFERENCES="ignore"
