[ "${TRACE:-}" = "YES" -o "${MULLE_TIMEOUT_TRACE:-}" = "YES" ] && set -x && : "$0" "$@"


#
# this script is needed because the system "timeout" can not do environment
# variables like timeout foo LD_PRELOAD=... if we do the LD_PRELOAD=.. too
# early, then timeout croaks with unresolved symbols with mulle-testallocator
#

# Version of the script
version="1.0.0"

# Show help
mulle_show_help()
{
    cat << EOF
Usage: $0 [OPTIONS] <timeout_seconds> [var=value]* <command...>

   You can also define environment variables before the command.
   Use <timeout_seconds> 0 for no timeout.

Options:
  -h, --help            Show this help message and exit
  --version             Show version info and exit
  -s, --signal=SIGNAL   Specify the signal to be sent on timeout (default: KILL)
  -v, --verbose         Output verbose information 
  -t, --terse           Only the return value indicates timeout
EOF
}

# Show version
mulle_show_version()
{
    echo "$0 version $version"
}

# Default values
signal="KILL"
verbose=1
timeout_seconds=""
cmd=""


# Ensure timeout seconds and command are provided
mulle_check_args()
{
    if [ -z "$timeout_seconds" ] || [ -z "$*" ]
    then
        echo "Usage: $0 <timeout_seconds> <command...>" >&2
        exit 2
    fi
}


# Convert signal name to number if needed
mulle_resolve_signal()
{
    if [[ "$signal" =~ ^[0-9]+$ ]]
    then
        signal_num=$signal
    else
        signal_num=$(kill -l "$signal")
        if [ -z "$signal_num" ]
        then
            echo "Invalid signal: $signal" >&2
            exit 2
        fi
    fi
}

# Start timeout background process for the given pid
mulle_start_timeout_process()
{
    (
        sleep "$timeout_seconds"
        # check if running
        if kill -0 "$1" 2>/dev/null
        then
            kill -$signal_num -$1 2>/dev/null
            if [ $verbose -gt 1 ]
            then
                echo "Timeout: sent $signal_num to process group $1"  >&2
            fi
        else
           if [ $verbose -gt 1 ]
           then
              echo "Process $1 already finished"  >&2
           fi
        fi
    ) &
    timeout_pid=$!
    if [ $verbose -gt 1 ]
    then
       echo "Timeout process $timeout_pid started" >&2
    fi
}

# Kill child process group (always use TERM, INT is ignored by non-interactive bash)
mulle_kill_child()
{
   if [ -n "${cmd_pid}" ] && kill -0 "$cmd_pid" 2>/dev/null
   then
      kill -TERM -"$cmd_pid" 2>/dev/null || kill -TERM "$cmd_pid" 2>/dev/null
   fi
}

# Run the command in a subshell
mulle_run_command_in_subshell()
{
   if [ $verbose -gt 1 ]
   then
       echo "Start process: $*" >&2
   fi

   # this is useful when you use LD_PRELOAD and you dont want to affect
   # other
   local cmdline
   local sep
   local envvar
   local key
   local value

   local escaped

   while [ $# -ne 0  ]
   do
      case "$1" in
         [A-Za-z_][A-Za-z0-9_]*=*)
            key="${1%%=*}"
            value="${1#*=}"
            printf -v escaped "%q" "${value}"
            cmdline="${cmdline}${sep}${key}=${escaped}"
            sep=" "
            shift
            continue
         ;;
      esac
      break
   done

   if [ $# -eq 0  ]
   then
      echo "Missing command" >&2
      exit 1
   fi


   while [ $# -ne 0  ]
   do
     printf -v escaped "%q" "$1"
     cmdline="${cmdline}${sep}${escaped}"
     sep=" "
     shift
   done

   # not exporting LD_PRELOAD protects our own shell
   # Create new process group - use setsid if available, otherwise use
   # perl POSIX::setsid (macOS has no setsid command but always has perl)
   if command -v setsid >/dev/null 2>&1
   then
       setsid bash -c "${cmdline}" 0<&0 &
   else
       perl -e 'use POSIX; POSIX::setsid(); exec "bash", "-c", $ARGV[0]' "${cmdline}" 0<&0 &
   fi
   cmd_pid=$!

   # Trap INT/TERM to forward to child process group before exiting
   trap 'mulle_kill_child; exit 130' INT
   trap 'mulle_kill_child; exit 143' TERM

   if [ $verbose -gt 1 ]
   then
       echo "Process $cmd_pid started" >&2
   fi
}

# Capture exit code of the command and clean up timeout
mulle_capture_exit_code()
{
    # wait can be interrupted by trapped signals, so loop
    while kill -0 "$cmd_pid" 2>/dev/null
    do
       wait "$cmd_pid" 2> /dev/null
       exit_code=$?
    done
    wait "$cmd_pid" 2> /dev/null
    exit_code=$?
}

# Handle timeout, cleanup and exit status
mulle_handle_timeout()
{
    # Check if process was killed by our timeout signal
    # Exit codes: 128 + signal_number for signals
    local expected_exit_code=$((128 + signal_num))
    
    if [ "$exit_code" -eq "$expected_exit_code" ]
    then
        if [ $verbose -ge 1 ]
        then
            echo "Command timed out" >&2
        fi
        exit 124
    fi
}

# Cleanup timeout process if command finishes early
mulle_cleanup_timeout()
{
    kill "$timeout_pid" 2>/dev/null
}

# Main function to orchestrate the timeout behavior
mulle_main()
{
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                mulle_show_help
                exit 0
                ;;
            --version)
                mulle_show_version
                exit 0
                ;;
            -s|--signal)
                signal=$2
                shift 2
                ;;
    
            -t|--terse)
                verbose=0
                shift
                ;;
            -v|--verbose)
                verbose=2
                shift
                ;;
            *)
               break
                ;;
        esac
    done

    if [ $# -gt 1 ]
    then
       timeout_seconds=$1
       shift
    fi

    mulle_check_args "$@"
    mulle_resolve_signal

    # Run the command in a subshell and get its PID
    mulle_run_command_in_subshell "$@"

    exit_code=124

    # Start the timeout process for the command's PID
    if [ "${timeout_seconds%%[!0-9]*}" -gt 0 ]
    then
       mulle_start_timeout_process "$cmd_pid"
    fi

    # Wait for the command to finish and capture its exit code
    mulle_capture_exit_code

    # Handle any timeout situations
    mulle_handle_timeout

    # Clean up the timeout process if the command finishes before timeout
    mulle_cleanup_timeout

    exit $exit_code
}

# Run the main function with all arguments
mulle_main "$@"
